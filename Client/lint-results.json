 lg: \"px-6 py-3 text-lg\",\n    xl: \"px-8 py-4 text-xl\",\n  };\n\n  const className = `${baseClasses} ${variants[variant]} ${sizes[size]}`;\n\n  return (\n    <Component className={className} disabled={disabled || loading} {...props}>\n      {loading ? (\n        <span className=\"flex items-center gap-2\">\n          <span className=\"inline-block w-4 h-4 border-2 border-t-transparent border-current rounded-full animate-spin\"></span>\n          {children}\n        </span>\n      ) : (\n        children\n      )}\n    </Component>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/nimishagrawal/Desktop/coding/fullstack/Projects/LegalSaas/client/src/components/ChatBubble.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/nimishagrawal/Desktop/coding/fullstack/Projects/LegalSaas/client/src/components/ChatInput.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/nimishagrawal/Desktop/coding/fullstack/Projects/LegalSaas/client/src/components/ChatWindow.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/nimishagrawal/Desktop/coding/fullstack/Projects/LegalSaas/client/src/components/ConversationMode.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/nimishagrawal/Desktop/coding/fullstack/Projects/LegalSaas/client/src/components/LanguageSelector.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/